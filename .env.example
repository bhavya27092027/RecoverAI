# RecoverAI Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (leave empty or use localhost; auto-embedded fallback enabled for dev if local mongod is absent)
MONGODB_URI=mongodb://localhost:27017/recoverai

# JWT Secret for Session Cookies
JWT_SECRET=your_secure_random_secret_here

# Client URL (for CORS and cookie origin)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
