# RecoverAI Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/recoverai
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/recoverai?retryWrites=true&w=majority

# JWT Secret for Session Cookies (Minimum 16 characters in production)
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Client URL (for CORS and cookie origin)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

# Razorpay TEST MODE Configuration (Optional - Demo provider works offline without this)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
