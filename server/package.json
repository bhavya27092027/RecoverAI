{
  "name": "recoverai-server",
  "version": "1.0.0",
  "description": "RecoverAI - Autonomous AI Revenue Recovery Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "ts-node --transpile-only src/tests/auth.test.ts",
    "test:e2e": "ts-node --transpile-only src/tests/e2e.test.ts",
    "test:phase2": "ts-node --transpile-only src/tests/phase2.test.ts",
    "test:phase3": "ts-node --transpile-only src/tests/phase3.test.ts",
    "test:phase4": "ts-node --transpile-only src/tests/phase4.test.ts",
    "test:phase5": "ts-node --transpile-only src/tests/phase5.test.ts",
    "test:audit": "ts-node --transpile-only src/tests/final_qa_audit.ts",
    "test:all": "npx tsx src/tests/auth.test.ts && npx tsx src/tests/phase2.test.ts && npx tsx src/tests/phase3.test.ts && npx tsx src/tests/phase4.test.ts && npx tsx src/tests/phase5.test.ts",
    "seed:demo": "ts-node --transpile-only src/scripts/seedDemoData.ts",
    "db:local": "ts-node --transpile-only src/scripts/startLocalDb.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "mongodb-memory-server": "^10.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
