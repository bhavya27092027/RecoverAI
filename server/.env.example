# ==============================================================================
# RecoverAI Server Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Persistent MongoDB Connection (Required for persistent storage)
# ------------------------------------------------------------------------------
# Option A: Local MongoDB (Default port 27017, start with: npm run db:local)
MONGODB_URI=mongodb://localhost:27017/recoverai

# Option B: MongoDB Atlas Cloud Cluster URI
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/recoverai?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=your_secure_random_jwt_secret_key_here

# ------------------------------------------------------------------------------
# Optional AI Enhancement (The engine is 100% functional offline without this)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
