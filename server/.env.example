# ==============================================================================
# RecoverAI Server Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Persistent MongoDB Connection (Local or Atlas Cloud)
# ------------------------------------------------------------------------------
# Option A: Local MongoDB
MONGODB_URI=mongodb://localhost:27017/recoverai

# Option B: MongoDB Atlas Cloud Cluster URI
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/recoverai?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=your_secure_random_jwt_secret_key_here

# ------------------------------------------------------------------------------
# Razorpay TEST MODE Payment Gateway (Optional - Demo provider works offline)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
